{
  "name": "dsh-auto-continue",
  "version": "2.0.0",
  "description": "Keeps a DeepSeek Harness turn from closing on an unfinished reply: a llm/stream guard turns silent truncation into a retry, and a completion protocol asks the model to declare how the turn ended",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-loop",
    "turn-stopping",
    "steering",
    "auto-continue",
    "stream-guard",
    "truncation"
  ],
  "author": "VergilYe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VergilYe/dsh-auto-continue.git"
  },
  "homepage": "https://github.com/VergilYe/dsh-auto-continue#readme",
  "bugs": {
    "url": "https://github.com/VergilYe/dsh-auto-continue/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
